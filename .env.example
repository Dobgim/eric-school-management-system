# Copy to .env and fill in. Never commit .env.

# Hosted PostgreSQL connection string (Neon, Supabase, Render, Railway…).
# Leave empty to use the built-in local database in .data/ (fine for testing on one computer).
DATABASE_URL=

# Long random string used to sign login sessions. REQUIRED in production.
JWT_SECRET=

# Password for the first Super Admin account (username: admin), used only when the database is empty.
ADMIN_PASSWORD=admin123

# Mobile Money through Fapshi (optional). Leave empty to run payments in demo mode, or enter the keys
# in the app instead (School Profile -> Settings), where they are stored encrypted.
FAPSHI_API_USER=
FAPSHI_API_KEY=
# live or sandbox
FAPSHI_MODE=live

# Key used to encrypt stored secrets (Fapshi keys, push keys). Defaults to JWT_SECRET.
SIS_ENCRYPTION_KEY=

# Web Push keys for phone notifications (optional: generated automatically and stored encrypted).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Port for `npm start` (hosts usually set this for you).
PORT=4000
